      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0.9,
          0
        ],
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 11.0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -5.0,
          0
        ],
