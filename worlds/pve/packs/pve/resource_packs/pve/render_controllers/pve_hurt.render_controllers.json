{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.pve_hurt": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "q.property('pve:hurt') ? 1.0 : this",
        "g": "q.property('pve:hurt') ? 0.25 : this",
        "b": "q.property('pve:hurt') ? 0.25 : this",
        "a": "q.property('pve:hurt') ? 0.5 : 0.0"
      }
    }
  }
}