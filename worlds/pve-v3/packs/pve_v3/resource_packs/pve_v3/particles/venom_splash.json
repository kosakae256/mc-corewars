{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pve_v3:venom_splash",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/pve3_droplet"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": false },
      "minecraft:emitter_rate_instant": { "num_particles": 26 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_sphere": { "radius": 0.35, "direction": "outwards" },
      "minecraft:particle_initial_speed": "math.random(1.4, 3.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.4,
        "linear_acceleration": [0, -7.5, 0]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-180, 180)"
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.35, 0.65)" },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.14 * (1 - v.particle_age / v.particle_lifetime) + 0.04", "0.14 * (1 - v.particle_age / v.particle_lifetime) + 0.04"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [0, 0], "uv_size": [16, 16] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": [0.62, 0.98, 0.34, 1.0],
            "0.5": [0.36, 0.78, 0.2, 1.0],
            "1.0": [0.18, 0.42, 0.1, 0.0]
          }
        }
      }
    }
  }
}
