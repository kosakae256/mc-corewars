{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pve_v3:foxfire_orbit",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/pve3_spark"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.65
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.055,
          0.14
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.5,
          0.35,
          1,
          "1 * (1 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 400) * (0.7 - v.particle_age * 0.65)",
          "v.particle_age * 0.4",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 400) * (0.7 - v.particle_age * 0.65)"
        ]
      }
    }
  }
}
