          "(0.12 + v.particle_random_1 * 0.12) * (1 - v.particle_age / v.particle_lifetime)",
          "(0.12 + v.particle_random_1 * 0.12) * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
