{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pve_v3:beam_trail",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/pve3_glow"
      }
    },
    "components": {
