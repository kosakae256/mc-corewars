{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pve_v3:foxfire_aura_blue",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/pve3_foxfire_blue"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_4 * 0.2"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(.16 + v.particle_random_4 * .12) * (1 - v.particle_age / v.particle_lifetime)",
          "(.16 + v.particle_random_4 * .12) * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.85 * (1 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 230) * (0.65 + v.particle_random_2 * 0.2)",
          ".15 + v.particle_random_3 * 1.8 + v.particle_age * .5",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 230) * (0.65 + v.particle_random_2 * 0.2)"
        ]
      }
    }
  }
}
