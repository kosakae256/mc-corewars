          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "fly": "q.property('pve_v3:fly')"
            },
            {
              "walk": "q.ground_speed > 0.08"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "fly": "q.property('pve_v3:fly')"
            },
            {
              "idle": "q.ground_speed <= 0.08"
            }
          ]
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "idle": "!q.property('pve_v3:fly')"
            }
          ]
        }
      }
    },
