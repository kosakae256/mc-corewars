{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pve3.katana": {
      "initial_state": "none",
      "states": {
        "none": {
          "transitions": [{ "charge": "query.mark_variant == 1" }]
        },
        "charge": {
          "animations": ["katana_charge"],
          "blend_transition": 0.15,
          "transitions": [
            { "slash": "query.mark_variant == 2" },
            { "none": "query.mark_variant == 0" }
          ]
        },
        "slash": {
          "animations": ["katana_slash"],
          "blend_transition": 0.05,
          "transitions": [{ "recover": "query.mark_variant != 2" }]
        },
        "recover": {
          "animations": ["katana_recover"],
          "blend_transition": 0.2,
          "transitions": [
            { "charge": "query.mark_variant == 1" },
            { "none": "query.all_animations_finished" }
          ]
        }
      }
    }
  }
}
