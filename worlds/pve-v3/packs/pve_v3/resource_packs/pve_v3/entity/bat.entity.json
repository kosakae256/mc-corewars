{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "pve_v3:bat",
      "materials": {
        "default": "bat_v2"
      },
      "textures": {
        "default": "textures/entity/bat_v2"
      },
      "geometry": {
        "default": "geometry.bat_v2"
      },
      "enable_attachables": true,
      "animations": {
        "resting": "animation.bat.resting",
        "flying": "animation.bat.flying"
      },
      "animation_controllers": [
        {
          "move": "controller.animation.bat.move"
        },
        {
          "roused_controller": "controller.animation.pve3.roused"
        }
      ],
      "scripts": {
        "scale": "1.0",
        "pre_animation": [
          "variable.attack_animation_tick = q.property('pve_v3:swing');"
        ]
      },
      "render_controllers": [
        "controller.render.pve3.bat.bat"
      ],
      "particle_effects": {
        "roused": "pve_v3:rouse_mark"
      }
    }
  }
}
