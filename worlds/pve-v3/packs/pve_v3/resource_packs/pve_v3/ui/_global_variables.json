	"$disable_5_slots_layout": true,
	"$disable_9_slots_layout": true,
	"$disable_18_slots_layout": true,
	"$disable_27_slots_layout": false,
	"$disable_36_slots_layout": true,
	"$disable_45_slots_layout": true,
	"$disable_54_slots_layout": true
