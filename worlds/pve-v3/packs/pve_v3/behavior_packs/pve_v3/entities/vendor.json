        "height": 0.75
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:persistent": {},
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "deals_damage": "no",
          "on_damage": {
            "filters": {
              "test": "has_damage",
              "value": "none"
            }
          }
        }
      },
      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": -20,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:loot": {
        "table": "loot_tables/empty.json"
      }
    }
  }
}
