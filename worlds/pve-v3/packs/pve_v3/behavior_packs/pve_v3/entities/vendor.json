{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "pve_v3:vendor",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "pve_v3:kind": {
          "type": "int",
          "range": [
            0,
            4
          ],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "components": {
