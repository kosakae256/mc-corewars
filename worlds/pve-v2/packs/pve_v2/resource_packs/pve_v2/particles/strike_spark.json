          "0.16 * (1 - (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [
            [
              1.0,
              1.0,
              0.8,
              1.0
            ],
            [
              1.0,
              0.75,
              0.15,
              0.0
            ]
          ],
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
