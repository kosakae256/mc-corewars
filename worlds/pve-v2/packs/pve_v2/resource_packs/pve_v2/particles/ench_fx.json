{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pve_v2:ench_fx",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/pve2_star"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": false },
      "minecraft:emitter_rate_instant": { "num_particles": 8 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 2.4,
      "minecraft:particle_motion_dynamic": { "linear_drag_coefficient": 3.5 },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.35 },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - (v.particle_age / v.particle_lifetime))",
          "0.16 * (1 - (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [
            [0.85, 0.95, 1.0, 0.95],
            [0.45, 0.75, 1.0, 0.0]
          ],
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      }
    }
  }
}
