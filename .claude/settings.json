{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hook-check.mjs\"",
            "timeout": 180,
            "statusMessage": "npm run check"
          }
        ]
      }
    ]
  }
}
